NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/sparkdate
JWT_ACCESS_SECRET=change-me-min-32-chars
JWT_REFRESH_SECRET=change-me-too-min-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
GOOGLE_CLIENT_IDS=your-android-client-id,your-ios-client-id
# WhatsApp provider: "console" (dev only) or "meta"
WHATSAPP_PROVIDER=console
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_TEMPLATE=otp_login
UPLOAD_DIR=/var/sparkdate/uploads
MEDIA_URL_SECRET=change-me-min-32-chars-media
MEDIA_URL_TTL_SEC=900
PUBLIC_BASE_URL=https://api.example.com
# true behind Nginx (internal location /protected-media/ -> UPLOAD_DIR)
USE_X_ACCEL=false
AUTH_IP_LIMIT_PER_15MIN=30
ADMIN_LOGIN_IP_LIMIT_PER_15MIN=10
CORS_ORIGINS=http://localhost:5173
