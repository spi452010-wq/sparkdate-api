NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/sparkdate
JWT_ACCESS_SECRET=change-me-min-32-chars
JWT_REFRESH_SECRET=change-me-too-min-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
GOOGLE_CLIENT_IDS=your-android-client-id,your-ios-client-id
# WhatsApp provider: "console" (dev only) or "meta"
WHATSAPP_PROVIDER=console
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_TEMPLATE=otp_login
UPLOAD_DIR=/var/sparkdate/uploads
MEDIA_URL_SECRET=change-me-min-32-chars-media
MEDIA_URL_TTL_SEC=900
PUBLIC_BASE_URL=https://api.example.com
# true behind Nginx (internal location /protected-media/ -> UPLOAD_DIR)
USE_X_ACCEL=false
AUTH_IP_LIMIT_PER_15MIN=30
ADMIN_LOGIN_IP_LIMIT_PER_15MIN=10
CORS_ORIGINS=http://localhost:5173
# --- Sprint 2: Google Play Billing, Pub/Sub RTDN, jobs (required in production) ---
PLAY_PACKAGE_NAME=com.example.sparkdate
# Service account JSON key: keep it OUTSIDE the repo, e.g. /etc/sparkdate/play-sa.json (never commit it)
GOOGLE_PLAY_SA_JSON_PATH=
CHAT_PASS_PRODUCT_ID=chat_pass_monthly
# Exact push endpoint URL configured on the Pub/Sub push subscription (OIDC audience)
PUBSUB_PUSH_AUDIENCE=https://api.example.com/api/v1/webhooks/play
# Service account email set on the push subscription's OIDC token
PUBSUB_SA_EMAIL=
# Leave empty in dev to use in-process timers instead of BullMQ
REDIS_URL=
BOOKING_HOLD_MIN=10
PENDING_PURCHASE_HOLD_MIN=30
AUTO_REFUND_NO_MATCH=false
# Firebase service account JSON (outside the repo); FCM sending is a TODO, in-app notifications work without it
FCM_SA_JSON_PATH=
